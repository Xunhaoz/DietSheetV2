# Copy to .env and replace every value. .env is gitignored.

POSTGRES_PASSWORD=change-me

# S3 credentials for SeaweedFS; generate the secret with `openssl rand -hex 32`.
S3_ACCESS_KEY=dietsheet
S3_SECRET_KEY=change-me

# Single owner for the minimal version; generate with `uuidgen`.
OWNER_ID=
# Bearer token used by iPhone Shortcuts; at least 32 characters or the API refuses to start.
# Generate with `openssl rand -hex 32`.
API_TOKEN=
